  "hypotheses":[
    {"id":"H1","statement":"Glass Cannon has the highest mean DPS but loses more often once boss HP exceeds 10,000.","rationale":"High attack and crit are offset by low HP and defense.","predictions":{"mean_dps":"highest","win_rate_at_12500":"< 0.75","damage_taken":"highest"},"test_method":"Compare all builds at boss_hp=5000,7500,10000,12500 with 1000 fights each.","confidence":0.65,"status":"untested"},
    {"id":"H2","statement":"A 0.50 second I-frame gives the controller a measurable survival advantage over 0.30 seconds.","rationale":"Longer invulnerability should reduce damage from telegraphed area attacks.","predictions":{"win_rate_delta":">= 0.05","damage_taken_delta":"<= -0.08"},"test_method":"Override fortress_controller.i_frame with 0.30 and 0.50 and replay identical seeds.","confidence":0.55,"status":"untested"},
    {"id":"H3","statement":"The boss is in a useful tuning range when median TTK is 25-55 seconds and win rate is 0.45-0.85.","rationale":"This leaves room for mastery without making the encounter a wall.","predictions":{"healthy_hp_range":[7500,10000]},"test_method":"Plot win-rate and TTK heatmaps over boss HP and build.","confidence":0.60,"status":"untested"}
