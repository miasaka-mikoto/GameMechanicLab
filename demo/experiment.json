  "research_question":"How do build archetype, boss HP, and critical scaling change win rate and time-to-kill?",
  "scope":{"arena":"2d_combat_arena","max_fight_seconds":120,"allowed_components":["hp","attack","defense","critical","attack_speed","cooldown","mana","stamina","i_frame","dodge","knockback","hitstun","projectile","aoe","dot","hot","buff","debuff","shield","combo"],"deterministic_seed":20261004},
